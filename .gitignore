# Node — maestro-flow is installed repo-locally (see docs/Build-Guide.md, Stage 0)
node_modules/

# Maestro runtime state: search cache, embedding index, daemon lockfile.
# Regenerated automatically; not shared between machines.
.workflow/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Environment
.env

maestro-flow documentation/

temp/
run_logs/
graph_images/

# Orchestrator run state: per-run artifacts, debug logs, and graph checkpoints.
# Regenerated per run and specific to one machine's target repository.
orchestrator/runs/
orchestrator/run_logs/
orchestrator/checkpoints/

.claude/
.graphifyignore
graphify-out/